{
  "name": "echo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "bun run --filter @echo/ip-service --filter @echo/dashboard dev",
    "build": "bun run --filter \"@echo/dashboard\" build",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "docker:local": "docker compose -f deploy/compose.local.yaml up --build -d",
    "docker:local:down": "docker compose -f deploy/compose.local.yaml down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "husky": "^9.1.7"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.17",
    "mmdb-lib": "3.0.4",
    "postcss": "^8.5.18",
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "vite": "8.1.6",
    "ws": "^8.21.0",
    "source-map-js": "1.2.2"
  }
}
