# === Quality Gate: pre-commit ===
# L1 + G2a (6DQ standard): checks the Git index snapshot, not the working tree.
set -e
command -v git >/dev/null 2>&1 || {
	echo "pre-commit: git is required" >&2
	exit 1
}
command -v bun >/dev/null 2>&1 || {
	echo "pre-commit: bun is required" >&2
	exit 1
}
command -v gitleaks >/dev/null 2>&1 || {
	echo "pre-commit: gitleaks is required" >&2
	exit 1
}

snapshot=
cleanup() {
	status=$?
	trap - EXIT INT TERM HUP
	if [ -n "$snapshot" ]; then
		rm -rf "$snapshot" || :
		snapshot=
	fi
	exit "$status"
}
trap cleanup EXIT
trap "exit 130" INT
trap "exit 143" TERM
trap "exit 129" HUP

snapshot=$(mktemp -d "${TMPDIR:-/tmp}/echo-index-XXXXXX")
# gitleaks reads the commit index. Strip Git's hook environment only after it.
gitleaks protect --staged --no-banner
git checkout-index --all --prefix="$snapshot/"
repo=$(git rev-parse --show-toplevel)

if [ ! -d "$repo/node_modules" ]; then
	echo "pre-commit: node_modules is required" >&2
	exit 1
fi
if [ ! -f "$snapshot/package.json" ] || [ ! -f "$snapshot/bun.lock" ]; then
	echo "pre-commit: staged package.json and bun.lock are required" >&2
	exit 1
fi
if ! cmp -s "$snapshot/package.json" "$repo/package.json" || ! cmp -s "$snapshot/bun.lock" "$repo/bun.lock"; then
	echo "pre-commit: staged package.json/bun.lock must match the installed worktree copies" >&2
	exit 1
fi

mkdir "$snapshot/node_modules"
for entry in "$repo/node_modules"/*; do
	[ -e "$entry" ] || continue
	ln -s "$entry" "$snapshot/node_modules/${entry##*/}"
done
ln -s "$repo/node_modules/.bin" "$snapshot/node_modules/.bin"
for pkg in "$repo"/packages/*/node_modules; do
	[ -d "$pkg" ] || continue
	pkg_dir=${pkg%/node_modules}
	rel=${pkg_dir#"$repo/"}
	mkdir -p "$snapshot/$(dirname "$rel")"
	ln -s "$pkg" "$snapshot/$rel/node_modules"
done
mkdir -p "$snapshot/node_modules/.vite" "$snapshot/node_modules/.vitest" "$snapshot/.cache"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
export XDG_CACHE_HOME="$snapshot/.cache"
export XDG_STATE_HOME="$snapshot/.cache"
PATH="$snapshot/node_modules/.bin:$PATH"

run_l1() {
	cd "$snapshot/packages/ip-service"
	bun run typecheck
	bun run test:coverage
	cd "$snapshot/packages/dashboard"
	bun run typecheck
	bun run test:coverage
	cd "$snapshot"
	bun run lint
}

if [ -n "${ECHO_L1_TIMEOUT_SEC:-}" ]; then
	if command -v timeout >/dev/null 2>&1; then
		timeout --preserve-status --signal=TERM "$ECHO_L1_TIMEOUT_SEC" sh -ec "
			cd \"$snapshot/packages/ip-service\"
			bun run typecheck
			bun run test:coverage
			cd \"$snapshot/packages/dashboard\"
			bun run typecheck
			bun run test:coverage
			cd \"$snapshot\"
			bun run lint
		"
	else
		echo "pre-commit: ECHO_L1_TIMEOUT_SEC requires coreutils timeout" >&2
		exit 1
	fi
else
	run_l1
fi
